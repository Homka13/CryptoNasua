# Bybit API Credentials (Obtain from Bybit -> API Management)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Telegram Bot Credentials (Obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LLM Confirmation Filter (Optional: Gemini / OpenAI / DeepSeek API)
USE_LLM_CONFIRMATION=false
LLM_PROVIDER=deepseek
LLM_API_KEY=your_gemini_or_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Trading Configuration
SYMBOL=SHIB/USDT
TIMEFRAME=15m
INITIAL_CAPITAL=10.0
TRADE_SIZE_USDT=2.5
PAPER_TRADING=true
TESTNET=false
